PORT=4050
MONGO_URI=mongodb://127.0.0.1:27017/game-log?replicaSet=rs0
SITE_URL=http://localhost:5040
SERVER_URL=http://localhost:4050
VITE_API_URL=/api
# Required in production; generated in .runtime when omitted in development.
SESSION_SECRET=
ALLOW_REGISTRATION=true
# Optional editable game metadata from a confidential Twitch/IGDB application.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Optional password recovery. Use a local SMTP capture server for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Number of trusted reverse proxies when deploying behind HTTPS.
TRUST_PROXY=
